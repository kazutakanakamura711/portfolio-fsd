Options -MultiViews
RewriteEngine On

# Keep the SSL validation path accessible
RewriteRule ^\.well-known/acme-challenge/ - [L]

# Redirect the root domain to www
RewriteCond %{HTTP_HOST} ^sakura-kn\.com$ [NC]
RewriteRule ^ https://www.sakura-kn.com%{REQUEST_URI} [R=301,L,NE]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
